<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <!-- FakeTimeProvider. Module 6's band boundaries (15/30/60s) and its 2h/30min expiries are only provable with
         an injected, controllable clock — a wall-clock test cannot prove a boundary transition (brief Risk #8). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <!-- Explicit secure overrides for vulnerable legacy netstandard transitive packages. -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SimPle.Application\SimPle.Application.csproj" />
    <ProjectReference Include="..\..\src\SimPle.Domain\SimPle.Domain.csproj" />
    <ProjectReference Include="..\..\src\SimPle.Shared\SimPle.Shared.csproj" />
    <ProjectReference Include="..\..\src\SimPle.Infrastructure\SimPle.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Committed golden-vector JSON files must land next to the test assembly so GoldenVectorTests can read
         them at run time without any repo-root path discovery. -->
    <None Include="GameHost\GoldenVectors\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
